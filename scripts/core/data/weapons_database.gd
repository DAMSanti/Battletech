# ============================================
# FUNCIONES DE CONSULTA
# ============================================

static func get_weapon(weapon_id: String) -> Dictionary:
	if database.has(weapon_id):
		return database[weapon_id].duplicate(true)
	return {}

static func get_all() -> Array:
	var result = []
	for weapon_id in database.keys():
		result.append(database[weapon_id].duplicate(true))
	return result

static func get_by_category(category: int) -> Array:
	var result = []
	for weapon_id in database.keys():
		var weapon = database[weapon_id]
		if weapon.get("category", -1) == category:
			result.append(weapon.duplicate(true))
	return result

static func has_weapon(weapon_id: String) -> bool:
	return database.has(weapon_id)
